<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SendMemoriesActivity">

    <!-- TextView for showing selected gallery -->
    <TextView
        android:id="@+id/selectedGalleryTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No gallery selected"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:padding="8dp" />


    <!-- Spinner for selecting a gallery -->
    <Spinner
        android:id="@+id/gallerySpinner"
        android:layout_width="161dp"
        android:layout_height="67dp"
        android:layout_below="@id/selectedGalleryTextView"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp" />

    <!-- ImageView for displaying the selected image -->
    <ImageView
        android:id="@+id/selectedImageView"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_below="@id/gallerySpinner"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:contentDescription="Selected Image"
        android:scaleType="centerCrop"
        android:src="@drawable/image_placeholder"
        android:layout_marginBottom="16dp" />

    <!-- Button for selecting an image -->
    <Button
        android:id="@+id/selectImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/addphoto"
        android:text="Select Image"
        android:layout_below="@id/selectedImageView"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp" />

    <!-- Button for uploading the selected image -->
    <Button
        android:id="@+id/uploadImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upload Image"
        android:layout_below="@id/selectImageButton"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp" />

</RelativeLayout>
