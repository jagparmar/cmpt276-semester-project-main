<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NostalgiaNest"
        tools:targetApi="31">
        <activity
            android:name=".SwiperGameStart"
            android:exported="false" />
        <activity
            android:name=".SwiperGame"
            android:exported="false" /> <!-- Main entry point of the app -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"> <!-- This is the launch activity -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Other activities (not accessible externally) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".JoinAGallery"
            android:exported="false"
            android:parentActivityName=".MemoriesActivity" />
        <activity
            android:name=".createGallery"
            android:exported="false"
            android:parentActivityName=".MemoriesActivity" /> <!-- RegisterActivity should be accessible externally for user registration -->
        <activity
            android:name=".RegisterActivity"
            android:exported="true" />
        <activity
            android:name=".GalleryActivity"
            android:exported="false"
            android:parentActivityName=".MemoriesActivity" />
        <activity
            android:name=".SendMemoriesActivity"
            android:exported="false" />
        <activity
            android:name=".MemoriesActivity"
            android:exported="false" /> <!-- Add SpecificGalleryActivity here -->
        <activity
            android:name=".SpecificGalleryActivity"
            android:exported="true" />

    </application>

</manifest>